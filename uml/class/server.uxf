MasterSocket
--

+ MasterSocket(id, ip, ua : string, 
        socket : SocketIO)
- slave : SlaveSocket
- types : array:string

--

- commandSlave(type : string,
        payload : any)
- requestSlave(code : string)
+ setSlave(slave : SlaveSocket)
# onType(type : string, payload : any)
+ onDisconnect()
+ toObject() : object
+ toString() : string</panel_attributes>
